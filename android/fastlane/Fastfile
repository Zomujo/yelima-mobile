default_platform(:android)

platform :android do
  desc "Run tests"
  lane :test do
    sh("flutter test")
  end

  desc "Submit a new Staging build to Firebase App Distribution"
  lane :deploy_staging do
    sh("flutter build apk --flavor staging -t lib/main_dev.dart")
    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID_STAGING"],
      apk_path: "../build/app/outputs/flutter-apk/app-staging-release.apk",
      release_notes: "Built from CI"
    )
  end

  desc "Deploy a new Production build to Google Play"
  lane :deploy_production do
    # sh runs in fastlane/, so build from the project root. Obfuscated, with symbols for Crashlytics.
    sh("cd ../.. && flutter build appbundle --flavor prod -t lib/main_prod.dart --obfuscate --split-debug-info=build/symbols")
    sh("cd ../.. && firebase crashlytics:symbols:upload --app=1:701397813152:android:8610ac187db89176af46c5 build/symbols")
    upload_to_play_store(
      track: 'production',
      aab: '../build/app/outputs/bundle/prodRelease/app-prod-release.aab'
    )
  end
end
