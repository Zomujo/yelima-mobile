default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    sh("flutter test")
  end

  desc "Push a new Staging build to TestFlight"
  lane :deploy_staging do
    sh("flutter build ipa --flavor staging -t lib/main_dev.dart --export-options-plist=ExportOptions.plist")
    upload_to_testflight(
      app_identifier: ENV["IOS_BUNDLE_ID_STAGING"],
      ipa: "../build/ios/ipa/*.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push a new Production build to App Store"
  lane :deploy_production do
    # sh runs in fastlane/, so build from the project root. Obfuscated, with symbols for Crashlytics.
    sh("cd ../.. && flutter build ipa --flavor prod -t lib/main_prod.dart --obfuscate --split-debug-info=build/symbols --export-options-plist=ios/fastlane/ExportOptions.plist")
    sh("cd ../.. && firebase crashlytics:symbols:upload --app=1:701397813152:ios:dbca261fce3a8e41af46c5 build/symbols")
    upload_to_app_store(
      app_identifier: ENV["IOS_BUNDLE_ID_PROD"],
      ipa: "../build/ios/ipa/*.ipa"
    )
  end
end
